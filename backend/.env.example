# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL — recommended, free forever)
# Get from: neon.tech → your project → Connection String
DATABASE_URL="postgresql://username:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by migrations. Neon: same string without "-pooler". Local: same as DATABASE_URL
DIRECT_URL="postgresql://username:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET=your_very_strong_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Client URL (frontend)
CLIENT_URL=http://localhost:3000

# ── Email, SMS and WhatsApp (all optional) ──────────────────────────────────
# Leave these empty and the system still works: messages are only recorded in
# Settings → Email & SMS (status "not set up"). Fill in ONE email option to send for real.
# On Render, add the same names under your backend service → Environment.
# New setups start in TEST MODE: only the addresses/numbers you list in
# Settings → Email & SMS receive anything, until you switch it to Live.

# Email option R — Resend (needs a domain you own, verified in Resend; works on Render)
#   resend.com → Domains: add your domain and paste the DNS records it shows
#   resend.com → API Keys: create a key
#   MAIL_FROM may be "Name <address>", e.g.  SAN TECH <no-reply@notification.example.com>
#   Resend is used first when RESEND_API_KEY is set. EMAIL_PROVIDER=resend|brevo|smtp forces one.
RESEND_API_KEY=
EMAIL_PROVIDER=

# Email option A — Brevo (free 300 emails/day; works on Render; a verified sender address is enough)
#   brevo.com → Senders: add and verify your sender address
#   brevo.com → SMTP & API → API Keys: create a key
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Santech connect

# Email option B — any SMTP server, e.g. Gmail (used only when no Resend or Brevo key is set)
#   Gmail: turn on 2-Step Verification, then create an App Password
#   (myaccount.google.com → Security → App passwords) and put it in SMTP_PASS.
#   Note: Render's free plan blocks SMTP ports, so this works on your computer only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS and WhatsApp — Twilio (twilio.com; the free trial sends to numbers you verify)
#   Console → Account Info: Account SID and Auth Token
#   TWILIO_SMS_FROM: your Twilio phone number (+1…) or a Messaging Service SID (MG…)
#   TWILIO_WHATSAPP_FROM: the WhatsApp sandbox number (Messaging → Try it out → WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# CallMeBot — free WhatsApp without Twilio (sends to your own number only)
# Setup: add +34 644 65 21 47 as a contact, send "I allow callmebot to send me messages",
# paste the apikey it replies with below.
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=
