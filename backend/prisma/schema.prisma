// SAN-BMS — Prisma Database Schema
// Santech Business Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// ENUMS
// ===========================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  SALES_MANAGER
  MARKETING_MANAGER
  PROJECT_MANAGER
  SALES_STAFF
  EMPLOYEE
  CUSTOMER
}

enum ClientCategory {
  SELF_EMPLOYED
  INSTITUTION
  INDUSTRY
  DISTRIBUTOR
}

enum ClientKind {
  INDIVIDUAL
  BUSINESS
  TEAM
  DELEGATION
}

enum ClientStatus {
  PROSPECT
  LEAD
  QUALIFIED
  CONTRACTOR
  INACTIVE
  LOST
}

enum ClientType {
  CONTRACTOR
  ACQUISITION
}

enum VisitOutcome {
  PENDING
  FOLLOW_UP
  INTERESTED
  NOT_INTERESTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  REQUIREMENT_ANALYSIS
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ContractStatus {
  DRAFT
  REVIEW
  APPROVAL
  SIGNING
  ACTIVE
  RENEWAL
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  AT_RISK
  DELAYED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  APPROVED
  INVOICED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  FIELD_VISIT
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  EVENT
  COLD_CALL
  OTHER
}

enum QuotationStatus {
  DRAFT
  INTERNAL_REVIEW
  MANAGER_APPROVAL
  CEO_APPROVAL
  APPROVED
  SENT
  VIEWED
  NEGOTIATION
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum VisitorStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  WALK_IN
}

enum VisitPurpose {
  SALES_MEETING
  CLIENT_MEETING
  CONTRACT_SIGNING
  DELIVERY
  INTERVIEW
  TRAINING
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum ProductCategory {
  EVS
  SANTRACK
  REVIXSAN
  SANBOOK
  SANHUB
  WEBSITE
  MOBILE_APP
  CRM
  ERP
  AI_SOLUTION
  IOT
  TRAINING
  CONSULTANCY
  MAINTENANCE
  OTHER
}

// ===========================
// USER & AUTH
// ===========================

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  phone         String?
  role          UserRole  @default(EMPLOYEE)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  employee              Employee?
  fieldVisitsLogged     FieldVisit[]   @relation("LoggedBy")
  tasksAssigned         Task[]         @relation("AssignedTo")
  tasksCreated          Task[]         @relation("AssignedBy")
  tasksApproved         Task[]         @relation("ApprovedBy")
  clientsManaged        Client[]       @relation("AccountManager")
  projectsManaged       Project[]      @relation("ProjectManager")
  opportunitiesAssigned Opportunity[]  @relation("OpportunityAssignedTo")
  contractsManaged      Contract[]     @relation("ContractManager")
  auditLogs             AuditLog[]
  incomeRecorded        IncomeEntry[]  @relation("IncomeRecordedBy")
  expensesRecorded      ExpenseEntry[] @relation("ExpenseRecordedBy")
  leadsAssigned         Lead[]         @relation("LeadAssignedTo")
  quotationsAssigned    Quotation[]    @relation("QuotationAssignedTo")
  notifications         Notification[]
  ticketsAssigned       SupportTicket[] @relation("TicketAssignedTo")
  ticketsCreated        SupportTicket[] @relation("TicketCreatedBy")
  departmentsHeaded     Department[]   @relation("DepartmentHead")
  visitorsHosted        Visitor[]      @relation("VisitorHost")

  @@map("users")
}

// ===========================
// EMPLOYEE
// ===========================

model Employee {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  employeeCode     String           @unique
  department       String
  position         String
  hireDate         DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)
  baseSalary       Float
  currency         String           @default("RWF")
  performanceScore Float            @default(0)
  skills           String[]
  managerId        String?
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     Employee[]       @relation("EmployeeManager")
  salaryRecords    SalaryRecord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("employees")
}

model SalaryRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       Int
  year        Int
  baseSalary  Float
  bonuses     Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  currency    String   @default("RWF")
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  expenseEntry ExpenseEntry?

  @@unique([employeeId, month, year])
  @@map("salary_records")
}

// ===========================
// CLIENTS
// ===========================

model Client {
  id                   String         @id @default(cuid())
  companyName          String?
  category             ClientCategory
  status               ClientStatus   @default(PROSPECT)
  clientType           ClientType     @default(ACQUISITION)
  registrationNumber   String?
  address              String?
  location             String?
  phone                String?
  email                String?
  website              String?
  industry             String?
  contactPersonName    String?
  contactPersonPhone   String?
  contactPersonEmail   String?
  assignedToId         String?
  assignedTo           User?          @relation("AccountManager", fields: [assignedToId], references: [id])
  notes                String?
  source               String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  kind                  ClientKind?
  active                Boolean     @default(true)
  services              String[]    @default([])
  fileAttachment        String?
  fullName              String?
  idNumber              String?
  tinNumber             String?
  teamName              String?
  orgName               String?
  leaderName            String?
  leaderPhone           String?
  leaderEmail           String?
  delegationName        String?
  origin                String?
  orgRepresented        String?
  visitPurpose          String?
  visitDate             DateTime?
  delegationRepName     String?
  delegationRepTitle    String?
  delegationRepPhone    String?
  delegationRepEmail    String?
  delegationRepLocation String?
  delegationRepCountry  String?

  // Relations
  members      ClientMember[]
  fieldVisits  FieldVisit[]
  opportunities Opportunity[]
  contracts    Contract[]
  invoices     Invoice[]
  projects     Project[]
  incomeEntries IncomeEntry[]
  quotations   Quotation[]
  tickets      SupportTicket[]

  @@map("clients")
}

model ClientMember {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  role       String
  memberType String   @default("TEAM")
  createdAt  DateTime @default(now())

  @@map("client_members")
}

// ===========================
// FIELD VISITS (from Excel)
// ===========================

model FieldVisit {
  id                   String         @id @default(cuid())
  visitDate            DateTime
  companyName          String
  category             ClientCategory
  location             String?
  contactName          String?
  contactPhone         String
  contactEmail         String?
  needsAndObservation  String         @db.Text
  whatSantechCanSell   String
  outcome              VisitOutcome   @default(PENDING)
  followUpDate         DateTime?
  finalDecision        String?
  comments             String?        @db.Text
  amountPromising      Float?
  contractWon          Boolean        @default(false)
  recordedById         String
  recordedBy           User           @relation("LoggedBy", fields: [recordedById], references: [id])
  clientId             String?
  client               Client?        @relation(fields: [clientId], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("field_visits")
}

// ===========================
// PRODUCTS / SERVICES
// ===========================

model Product {
  id          String          @id @default(cuid())
  name        String
  category    ProductCategory
  description String?
  price       Float
  cost        Float?
  taxRate     Float           @default(0)
  sla         String?
  currency    String          @default("RWF")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  opportunityProducts OpportunityProduct[]

  @@map("products")
}

// ===========================
// SALES PIPELINE
// ===========================

model Opportunity {
  id                 String        @id @default(cuid())
  name               String
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  stage              PipelineStage @default(NEW_LEAD)
  estimatedValue     Float
  currency           String        @default("RWF")
  probability        Float         @default(0)
  expectedCloseDate  DateTime?
  assignedToId       String
  assignedTo         User          @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id])
  notes              String?
  nextAction         String?
  followUpDate       DateTime?
  lostReason         String?
  products           OpportunityProduct[]
  contractId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("opportunities")
}

// Many-to-many: Opportunity <-> Product
model OpportunityProduct {
  opportunityId String
  productId     String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@id([opportunityId, productId])
  @@map("opportunity_products")
}

// ===========================
// CONTRACTS
// ===========================

model Contract {
  id                  String         @id @default(cuid())
  contractNumber      String         @unique
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id])
  projectName         String?
  value               Float
  currency            String         @default("RWF")
  startDate           DateTime
  endDate             DateTime
  paymentTerms        String?
  deliverables        String?        @db.Text
  status              ContractStatus @default(DRAFT)
  responsibleManagerId String?
  responsibleManager  User?          @relation("ContractManager", fields: [responsibleManagerId], references: [id])
  signedAt            DateTime?
  signedDocumentUrl   String?
  signedDocumentName  String?
  signatories         Json?          // [{ name, status: PENDING|SIGNED, signedAt }]
  approvalNote        String?
  sourceQuotationNumber String?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  projects Project[]
  invoices Invoice[]

  @@map("contracts")
}

// ===========================
// INVOICES & PAYMENTS
// ===========================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      Contract?     @relation(fields: [contractId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  milestone     Milestone?
  amount        Float
  taxAmount     Float         @default(0)
  totalAmount   Float
  currency      String        @default("RWF")
  issueDate     DateTime
  dueDate       DateTime
  paidAmount    Float         @default(0)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("invoices")
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  currency      String   @default("RWF")
  paymentDate   DateTime
  paymentMethod String
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  incomeEntry   IncomeEntry?

  @@map("payments")
}

// ===========================
// PROJECTS & TASKS
// ===========================

model Project {
  id               String        @id @default(cuid())
  name             String
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  contractId       String?
  contract         Contract?     @relation(fields: [contractId], references: [id])
  projectManagerId String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  budget           Float
  contractValue    Float
  currency         String        @default("RWF")
  startDate        DateTime
  endDate          DateTime
  priority         Priority      @default(MEDIUM)
  status           ProjectStatus @default(PLANNING)
  progress         Float         @default(0)
  description      String?       @db.Text
  risks            String?
  tasks            Task[]
  milestones       Milestone[]
  invoices         Invoice[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("projects")
}

model Milestone {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  name              String
  milestoneNumber   Int             @default(1)
  description       String?         @db.Text
  deadline          DateTime
  deliverables      String?
  paymentPercentage Float    @default(0)
  status            MilestoneStatus @default(NOT_STARTED)
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?
  approvedAt        DateTime?
  invoiceId         String?         @unique
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("milestones")
}

model Task {
  id              String     @id @default(cuid())
  title           String
  description     String?    @db.Text
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  assignedToId    String
  assignedTo      User       @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById    String
  assignedBy      User       @relation("AssignedBy", fields: [assignedById], references: [id])
  priority        Priority   @default(MEDIUM)
  startDate       DateTime?
  deadline        DateTime
  estimatedHours  Float?
  actualHours     Float?
  status          TaskStatus @default(CREATED)
  rejectionReason String?
  completedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?      @relation("ApprovedBy", fields: [approvedById], references: [id])
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("tasks")
}

// ===========================
// AUDIT TRAIL
// ===========================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String
  entityName  String?
  description String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ===========================
// INCOME & EXPENSES (simple accounting layer)
// ===========================

model IncomeEntry {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  category     String   // Software Dev, EVS, SANTRACK, Website, Training, Maintenance, Other
  amount       Float
  currency     String   @default("RWF")
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  clientName   String?
  paymentId    String?  @unique // set when the income comes from an invoice payment
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User     @relation("IncomeRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("income_entries")
}

model ExpenseEntry {
  id             String        @id @default(cuid())
  date           DateTime
  description    String
  category       String        // Salaries, Rent, Internet, Equipment, Marketing, Transport, Other
  amount         Float
  currency       String        @default("RWF")
  notes          String?
  salaryRecordId String?       @unique // set when the expense comes from paying a salary
  salaryRecord   SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  recordedById   String
  recordedBy     User          @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt      DateTime      @default(now())

  @@map("expense_entries")
}

// ===========================
// LEADS (before they become clients)
// ===========================

model Lead {
  id             String         @id @default(cuid())
  companyName    String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  category       ClientCategory
  source         LeadSource     @default(FIELD_VISIT)
  interestedIn   String
  status         LeadStatus     @default(NEW)
  assignedToId   String?
  assignedTo     User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  followUpDate   DateTime?
  estimatedValue Float          @default(0)
  notes          String?        @db.Text
  clientId       String?        // set when converted
  opportunityId  String?        // set when converted
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("leads")
}

// ===========================
// QUOTATIONS
// ===========================

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  status          QuotationStatus @default(DRAFT)
  items           Json            // [{ id, description, quantity, unitPrice, total }]
  subtotal        Float
  vatRate         Float           @default(0)
  vatAmount       Float           @default(0)
  totalAmount     Float
  currency        String          @default("RWF")
  validUntil      DateTime?
  paymentTerms    String?
  notes           String?         @db.Text
  assignedToId    String?
  assignedTo      User?           @relation("QuotationAssignedTo", fields: [assignedToId], references: [id])
  linkedDeal      String?
  approvalHistory Json?           // [{ status, action, actor, createdAt }]
  sentAt          DateTime?
  acceptedAt      DateTime?
  contractId      String?         // set when converted to a contract
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("quotations")
}

// ===========================
// NOTIFICATIONS (in-app reminders)
// ===========================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // PAYMENT_DUE, OVERDUE, CONTRACT_EXPIRY, FOLLOW_UP, TASK_DEADLINE, SYSTEM
  title       String
  description String
  link        String?
  key         String?  // stops the same reminder being created twice
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, key])
  @@map("notifications")
}

// ===========================
// SUPPORT TICKETS
// ===========================

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNo     String       @unique
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  subject      String
  description  String       @db.Text
  product      String
  priority     Priority     @default(MEDIUM)
  status       TicketStatus @default(NEW)
  assignedToId String?
  assignedTo   User?        @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User         @relation("TicketCreatedBy", fields: [createdById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("support_tickets")
}

// ===========================
// DEPARTMENTS
// ===========================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique // matches Employee.department
  description String?
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  budget      Float    @default(0)
  color       String   @default("bg-blue-100 text-blue-700")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

// ===========================
// RECEPTION / VISITORS
// ===========================

model Visitor {
  id               String        @id @default(cuid())
  visitorName      String
  company          String?
  phone            String?
  email            String?
  idNumber         String?
  purpose          VisitPurpose
  hostId           String?
  host             User?         @relation("VisitorHost", fields: [hostId], references: [id])
  expectedDate     DateTime
  expectedTime     String?
  expectedDuration Int           @default(60)
  checkInTime      DateTime?
  checkOutTime     DateTime?
  status           VisitorStatus @default(EXPECTED)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("visitors")
}
